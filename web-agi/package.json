{
  "name": "web-agi",
  "private": true,
  "version": "0.1.0",
  "description": "A Sierra AGI game engine that runs in the browser",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "game:sync": "node scripts/build-manifest.mjs",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "agi-extract": "*"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.6.0",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=22"
  }
}
